# Root env (used by `pnpm create-admin` and optionally other tooling)
# "Username" is the login email in this app.

APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change-me-strong-password
# Optional:
# APP_ADMIN_FIRST_NAME=Admin
# APP_ADMIN_LAST_NAME=User

# Aliases also supported: ADMIN_EMAIL, ADMIN_USERNAME, ADMIN_PASSWORD
